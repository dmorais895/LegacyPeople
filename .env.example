# =============================================================================
# LegacyPeople — Arquivo de exemplo de variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de iniciar a aplicação:
#   cp .env.example .env
#
# O arquivo .env é ignorado pelo Git (.gitignore) para proteger credenciais.
# =============================================================================

# -----------------------------------------------------------------------------
# Django — Configurações Essenciais
# -----------------------------------------------------------------------------

# Chave secreta do Django. NUNCA use o valor padrão em produção.
# Gere uma chave segura com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=substitua-por-uma-chave-secreta-segura

# Modo de depuração. Use True apenas em desenvolvimento. NUNCA em produção.
DEBUG=True

# Hosts permitidos (separados por vírgula). Em desenvolvimento pode deixar vazio (DEBUG=True usa '*').
# Exemplo de produção: ALLOWED_HOSTS=legacypeople.com.br,www.legacypeople.com.br
ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------

# Engine do banco de dados.
# Desenvolvimento local com SQLite (sem MySQL necessário):
#   DB_ENGINE=django.db.backends.sqlite3
# Produção ou Docker com MySQL:
#   DB_ENGINE=django.db.backends.mysql
DB_ENGINE=django.db.backends.sqlite3

# As variáveis abaixo são ignoradas quando DB_ENGINE=sqlite3
DB_NAME=legacypeople
DB_USER=django
DB_PASSWORD=django
DB_HOST=127.0.0.1
DB_PORT=3306

# Senha do usuário root do MySQL (usada apenas no Docker Compose)
DB_ROOT_PASSWORD=root
