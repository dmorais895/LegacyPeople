# =============================================================================
# LegacyPeople — Arquivo de exemplo de variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de iniciar a aplicação:
#   cp .env.example .env
#
# O arquivo .env é ignorado pelo Git (.gitignore) para proteger credenciais.
# =============================================================================

# -----------------------------------------------------------------------------
# Django — Configurações Essenciais
# -----------------------------------------------------------------------------

# Chave secreta do Django. NUNCA use o valor padrão em produção.
# Gere uma chave segura com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=substitua-por-uma-chave-secreta-segura

# Modo de depuração.
#   True  → Desenvolvimento local ou container de dev (mostra erros detalhados, ALLOWED_HOSTS=*)
#   False → Produção (requer ALLOWED_HOSTS definido, HTTPS forçado, cookies seguros)
# NUNCA defina True em produção.
DEBUG=True

# Hosts permitidos (separados por vírgula).
#   - Em DEBUG=True: pode ser deixado vazio (usa '*' automaticamente).
#   - Em DEBUG=False: OBRIGATÓRIO. Ex: legacypeople.com.br,www.legacypeople.com.br
ALLOWED_HOSTS=

# IPs/CIDRs dos proxies que podem fornecer X-Forwarded-For (separados por vírgula).
# Vazio ignora o header. Configure apenas proxies sob seu controle, que removem
# ou acrescentam o IP real ao header. Nunca use 0.0.0.0/0 ou ::/0.
TRUSTED_PROXY_CIDRS=

# Apenas docker-compose.prod.yml: hostname público, sem https:// ou caminho.
# A produção força DEBUG=False e deriva ALLOWED_HOSTS deste hostname.
SITE_DOMAIN=

# Rede privada do proxy de produção. Ajuste ambos se houver conflito de subrede.
PROXY_SUBNET=172.30.0.0/24
PROXY_IP=172.30.0.10

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------

# Engine do banco de dados.
#   SQLite  (dev local sem MySQL): DB_ENGINE=django.db.backends.sqlite3
#   MySQL   (Docker ou produção):  DB_ENGINE=django.db.backends.mysql
#
# Nota: o docker-compose.yml ignora esta variável e força MySQL automaticamente.
DB_ENGINE=django.db.backends.sqlite3

# As variáveis abaixo são ignoradas quando DB_ENGINE=sqlite3.
# São obrigatórias quando DB_ENGINE=mysql ou ao usar docker-compose.
DB_NAME=legacypeople
DB_USER=django
DB_PASSWORD=django
DB_HOST=127.0.0.1
DB_PORT=3306

# Senha do usuário root do MySQL (usada apenas no Docker Compose para inicializar o serviço db)
DB_ROOT_PASSWORD=root
